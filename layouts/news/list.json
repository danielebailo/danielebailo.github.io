{{- $index := slice -}}
{{- range .RegularPagesRecursive -}}
  {{- if not .Params.searchHidden -}}
    {{- $image := "" -}}
    {{- $page := . -}}
    {{- with .Params.cover.image -}}
      {{- $coverImage := . -}}
      {{- $cover := ($page.Resources.ByType "image").GetMatch (printf "*%s*" $coverImage) -}}
      {{- if $cover -}}
        {{- $image = ($cover.Resize "160x").RelPermalink -}}
      {{- else if or (hasPrefix $coverImage "http://") (hasPrefix $coverImage "https://") -}}
        {{- $image = $coverImage -}}
      {{- end -}}
    {{- end -}}
    {{- $index = $index | append (dict
      "title" .Title
      "content" .Plain
      "permalink" .RelPermalink
      "summary" (.Summary | plainify | htmlUnescape)
      "date" (.Date.Format "2006-01-02")
      "tags" (.Params.tags | default slice)
      "categories" (.Params.categories | default slice)
      "image" $image
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
